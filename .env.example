# Copy to `.env` for local development: cp .env.example .env
# Every variable is validated at startup (src/config/env.schema.ts).
# Docker Compose reads this file too; its own variables are at the bottom.

# Required, no default: development | production | test. Production masks internal errors.
NODE_ENV=development
# HTTP port of the API (GraphQL + Apollo Sandbox at /graphql)
PORT=3000
# fatal | error | warn | log | debug | verbose (JSON output when NODE_ENV=production)
LOG_LEVEL=log
# Proxy hops in front of the app: 0 (no proxy) to 3, 1 on Railway. Set it behind a proxy.
# Startup rejects true and proxy lists: a client could spoof X-Forwarded-For and bypass the rate limit.
# With 0 behind a proxy every visitor shares the proxy IP, so one abuser's 429s hit everyone.
TRUST_PROXY=0
# `*` or a comma-separated list of allowed browser origins
CORS_ORIGINS=*

# At most RATE_LIMIT_MAX HTTP requests to /graphql per client IP within RATE_LIMIT_TTL_MS
# Counters live in process memory: with several replicas each one allows its own RATE_LIMIT_MAX
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Maximum cost of one GraphQL operation (1 per selected field, aliases included)
GRAPHQL_MAX_COMPLEXITY=250

# Connection string of the local PostgreSQL used by `npm run start:dev`
DATABASE_URL=postgresql://card:card@localhost:5432/card
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Read by docker-compose.yml only, never by the application.
# The defaults below match DATABASE_URL above, so `docker compose up --build`
# needs no edits; uncomment a line to change it.
#POSTGRES_USER=card
#POSTGRES_PASSWORD=card
#POSTGRES_DB=card
# Host port for the database; the container always listens on 5432 internally.
#POSTGRES_PORT=5432
# Host port the API is published on; PORT above is the port inside the container.
#APP_PORT=3000
